# Required
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-virtual-key

# Optional: protect /v1/generate with Bearer token (leave empty to disable)
API_KEY=

# Main / backup model when the caller omits model / fallback_model.
# Switch them here and restart; no code change needed (see README).
# Empty DEFAULT_FALLBACK_MODEL disables the default backup.
DEFAULT_MODEL=gemini-nano-banana-2.1
DEFAULT_FALLBACK_MODEL=doubao-seedream-5-0-pro

# Optional (defaults shown)
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=storage/images
STATIC_URL_PREFIX=/static/images
SERVICE_BASE_URL=http://localhost:8090
HOST=0.0.0.0
PORT=8090
RATE_LIMIT_GLOBAL=20
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW=60
CACHE_TTL_SECONDS=604800

# Volcengine Ark (Seedream image models) — required to use any doubao-seedream-* model
ARK_API_KEY=
# Optional (defaults shown)
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Wire id behind the doubao-seedream-4-5 / doubao-seedream-4-0 aliases only;
# Seedream 5.0 models pin their own wire ids in src/config.py.
ARK_MODEL_ID=doubao-seedream-4-5-251128

# Alibaba Bailian (Qwen-Image models) — required to use any qwen-image-* model
DASHSCOPE_API_KEY=
# Optional (default shown); Alibaba also offers per-workspace hosts:
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Automatic reference images (reference_subject). Comma-separated Tavily keys,
# shared with reader-service's pool; empty disables reference search.
TAVILY_API_KEYS=
# Optional (defaults shown)
REFERENCE_JUDGE_MODEL=gemini-3.8-flash
REFERENCE_SEARCH_IMAGES=1
