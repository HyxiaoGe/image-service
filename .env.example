# Gemini backup and automatic reference-image judging (LiteLLM)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-virtual-key

# Optional: protect /v1/generate with Bearer token (leave empty to disable)
API_KEY=

# Identity migration: legacy preserves existing REST-key / anonymous-MCP behavior.
# mixed accepts JWT + API_KEY, required accepts only target JWTs on REST and MCP.
AUTH_MODE=legacy
LEGACY_APP_ID=legacy
ALLOW_LEGACY_ANONYMOUS=false
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=image-service
AUTH_LEEWAY_SECONDS=5
# Shared auth-service Redis (including database index); empty reuses REDIS_URL.
AUTH_REDIS_URL=
# JSON mapping of authenticated products to server-side Ark environment-variable refs.
# Fill real keys only on the server; these names are examples, not deployed credentials.
# PRODUCTS={"fusion":{"authorized_parties":["fusion-api"],"ark_key_env":"FUSION_ARK_API_KEY","ark_key_alias":"fusion"},"validation":{"authorized_parties":["validation-cli"],"ark_key_env":"VALIDATION_ARK_API_KEY","ark_key_alias":"validation"}}
PRODUCTS={}
FUSION_ARK_API_KEY=
VALIDATION_ARK_API_KEY=

# Durable generation accounting on the existing ./storage volume.
USAGE_ENABLED=true
# Empty: parent of STORAGE_DIR + /usage.sqlite3 (default storage/usage.sqlite3).
USAGE_DB_PATH=
USAGE_RETENTION_DAYS=90

# Main model / backup chain when the caller omits model / fallback_model.
# Switch them here and recreate the container; no code change needed (see README).
# DEFAULT_FALLBACK_MODEL is comma-separated and tried in order; empty disables it.
DEFAULT_MODEL=doubao-seedream-5-0-flash
DEFAULT_FALLBACK_MODEL=gemini-nano-banana-2.1,qwen-image-3.0

# Optional (defaults shown)
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=storage/images
STATIC_URL_PREFIX=/static/images
SERVICE_BASE_URL=http://localhost:8090
HOST=0.0.0.0
PORT=8090
RATE_LIMIT_GLOBAL=20
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW=60
CACHE_TTL_SECONDS=604800

# One total deadline for preparation, cache waits, generation and bounded cleanup.
# Keep below the caller's timeout (Fusion: 150s). Per-model limits include retries.
GENERATION_TIMEOUT_SECONDS=135
MODEL_TIMEOUT_SECONDS=60
SEEDREAM_PRO_TIMEOUT_SECONDS=105
# Reserve this much for at least one backup when the initial model is slow.
FALLBACK_RESERVE_SECONDS=30
MIN_MODEL_BUDGET_SECONDS=5

# Volcengine Ark — required for the default Flash model and all doubao-seedream-* models
ARK_API_KEY=
# Optional (defaults shown)
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Wire id behind the doubao-seedream-4-5 / doubao-seedream-4-0 aliases only;
# Seedream 5.0 models pin their own wire ids in src/config.py.
ARK_MODEL_ID=doubao-seedream-4-5-251128

# Alibaba Bailian (Qwen-Image models) — required to use any qwen-image-* model
DASHSCOPE_API_KEY=
# Optional (default shown): native DashScope API root. Alibaba also offers
# per-workspace hosts: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Automatic reference images (reference_subject). Comma-separated Tavily keys,
# shared with reader-service's pool; empty disables reference search.
TAVILY_API_KEYS=
# Optional (defaults shown)
REFERENCE_JUDGE_MODEL=gemini-3.8-flash
REFERENCE_SEARCH_IMAGES=1
